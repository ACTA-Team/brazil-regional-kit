# ──────────────────────────────────────────────────────────────────────────────
# Brazil Regional Kit — environment
#
# EVERYTHING here is optional. With no .env.local at all the whole hub runs in
# MOCK mode against recorded fixtures: `pnpm install && pnpm dev` just works.
# Copy to `.env.local` only when you want to hit the live Etherfuse sandbox.
# ──────────────────────────────────────────────────────────────────────────────

# ── Global mode ───────────────────────────────────────────────────────────────
# live | mock   (default: mock)
RAMP_MODE=mock

# Per-adapter overrides. Take precedence over RAMP_MODE.
# ETHERFUSE_MODE=live
# SEP_MODE=live

# ── Etherfuse (the only self-service PIX sandbox) ─────────────────────────────
# Get a sandbox key at https://devnet.etherfuse.com/ramp
# NOTE: the Authorization header is the raw key — NO "Bearer " prefix.
#
# ⚠ THIS FILE IS COMMITTED TO THE REPOSITORY. Never paste a real key here.
#   Copy this file to .env.local — which is gitignored — and put it there.
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com

# Created ONCE by `pnpm setup:etherfuse`. Never regenerate these per session —
# doing so orphans previous orders. Paste the printed values here.
ETHERFUSE_CUSTOMER_ID=
ETHERFUSE_BANK_ACCOUNT_ID=

# ── Stellar network ───────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── SEP anchor (SDF public test anchor — no signup, no key) ───────────────────
SEP_ANCHOR_HOME_DOMAIN=testanchor.stellar.org

# ── DEX swap ──────────────────────────────────────────────────────────────────
# dex | simulated   (default: simulated; `dex` falls back automatically when
# no path exists on testnet, so it is always safe to turn on)
SWAP_MODE=simulated

# Market-maker account seeded by `pnpm seed:liquidity`. Testnet only — this key
# is disposable and funded by friendbot. NEVER put a mainnet secret here.
MARKET_MAKER_SECRET=

# ── Demo ──────────────────────────────────────────────────────────────────────
# Disposable testnet account used by `pnpm demo:fund <address>` to buy TESOURO
# and USDC on the open order books and send them to your wallet. Without an
# Etherfuse key the mock on-ramp cannot mint real TESOURO, and the corridor's
# DEX swap and the off-ramp both need the asset to genuinely be there.
# Testnet only — the script prints a fresh key if this is empty.
DEMO_FUNDER_SECRET=

# Recipient account for the São Paulo → Mexico remittance corridor demo.
NEXT_PUBLIC_DEMO_RECIPIENT_ADDRESS=

# ── Identity (ACTA did:stellar) ───────────────────────────────────────────────
# Optional, like everything else. Without it the identity page runs in a
# labelled mock: the whole flow works and nothing reaches a chain.
#
# live | mock   (falls back to RAMP_MODE, then mock). Live needs ALL THREE of
# the values below — a half-configured layer degrades to mock rather than
# failing at the first click.
# IDENTITY_MODE=live

# Credentials API key. Bound to ONE wallet: the vault owner must be that wallet,
# which is why attestations live in the hub's vault rather than each user's.
ACTA_API_KEY=
ACTA_API_URL=https://api.testnet.acta.build

# The DID resolver. No authentication, no key custody — it only builds unsigned
# transactions and resolves the registry contract over RPC.
DID_RESOLVER_URL=https://did.acta.build

# Created ONCE by `pnpm setup:identity`. Every attestation the hub has signed
# points at this DID; minting a new one orphans all of them.
#
# ⚠ SERVER-SIDE ONLY. This secret signs credential issuance and can spend the
#   issuer account. Never prefix it NEXT_PUBLIC_ — Next inlines those into the
#   browser bundle. Testnet only.
IDENTITY_ISSUER_SECRET=
IDENTITY_ISSUER_DID=
