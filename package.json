{
  "name": "brazil-regional-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Open ramp kit for Brazil and LATAM on Stellar: PIX on/off-ramp, multi-anchor router, regional stablecoin toolkit and x402 payments.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @brk/hub dev",
    "build": "pnpm build:packages && pnpm --filter @brk/hub build",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "start": "pnpm --filter @brk/hub start",
    "sample": "pnpm --filter @brk/sample-remit start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --parallel exec tsc --noEmit",
    "test:mutation": "stryker run",
    "audit:check": "tsx scripts/audit.ts",
    "audit:baseline": "tsx scripts/audit.ts --write-baseline",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm audit:check",
    "demo:fund": "tsx scripts/fund-demo.ts",
    "setup:etherfuse": "tsx scripts/etherfuse-setup.ts",
    "setup:identity": "tsx scripts/identity-setup.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "seed:liquidity": "tsx scripts/seed-liquidity.ts",
    "prepare": "husky",
    "diagnose": "tsx scripts/doctor.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@brk/adapter-etherfuse": "workspace:*",
    "@brk/adapter-sep": "workspace:*",
    "@brk/identity-kit": "workspace:*",
    "@brk/ramp-core": "workspace:*",
    "@brk/ramp-router": "workspace:*",
    "@brk/stablecoin-kit": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
