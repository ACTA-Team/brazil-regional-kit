{
  "name": "@brk/ramp-core",
  "version": "0.1.0",
  "description": "Anchor-agnostic types, errors and asset helpers for fiat on/off-ramps on Stellar. The contract every ramp adapter implements.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.5.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
