{
  "name": "@brk/adapter-etherfuse",
  "version": "0.1.0",
  "description": "Etherfuse ramp adapter — BRL↔TESOURO via PIX, MXN↔CETES via SPEI. Live sandbox with fixture-backed mock mode.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "fixtures"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap"
  },
  "dependencies": {
    "@brk/ramp-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.5.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
